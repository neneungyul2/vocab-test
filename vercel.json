{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",       "destination": "/admin.html" },
    { "source": "/admin",  "destination": "/admin.html" },
    { "source": "/student","destination": "/student.html" }
  ]
}
