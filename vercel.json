{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/",        "dest": "/admin.html" },
    { "src": "/admin",   "dest": "/admin.html" },
    { "src": "/student", "dest": "/student.html" },
    { "src": "/(.*\\.html)", "dest": "/$1" }
  ]
}
